pipeline {
    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                sh 'echo "Checkout passed"'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'
                sh '''
                    cd spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        cd spring-boot-app
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                        -Dsonar.projectKey=my-ec2-project \
                        -Dsonar.projectName="Spring Boot App" \
                        -Dsonar.host.url=$SONAR_HOST_URL
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "ligha/spring-boot-app:${BUILD_NUMBER}"
            }

            steps {
                script {
                    sh 'docker build -t ${DOCKER_IMAGE} spring-boot-app'

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }
stage('Update Deployment File') {
    environment {
        GIT_REPO_NAME = "java-maven-sonar-argocd"
        GIT_USER_NAME = "lighacu" // Update to match your GitHub owner username
    }
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'git-hub', // Matches your Jenkins Credential ID from the screenshot
                usernameVariable: 'GITHUB_USERNAME',
                passwordVariable: 'GITHUB_TOKEN'
            )
        ]) {
            sh '''
                # 1. Clean up any previous temporary clone
                rm -rf repo-temp

                # 2. Clone the repository fresh with authenticated URL
                git clone https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git repo-temp

                # 3. Enter the cloned repository root
                cd repo-temp

                # 4. Configure Git identity
                git config user.email "gopikakt2005@gmail.com"
                git config user.name "${GIT_USER_NAME}"

                # 5. Update the image tag in your manifest file
                sed -i "s|image: .*|image: gopikakt2005/static-website:${BUILD_NUMBER}|g" spring-boot-app-manifest/deployment.yml

                # 6. Commit and Push
                git add spring-boot-app-manifest/deployment.yml
                git commit -m "Update static site image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
                git push origin main
            '''
        }
    }
}
       
    }
}
